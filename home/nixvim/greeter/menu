{mk}:

[
	{
		on_press = mk ''function() vim.ui.input({
		prompt = "Name of the note: "}, function(name)
		vim.cmd("edit " .. name .. ".tex")
		vim.api.nvim_buf_set_lines(0, 0, -1, false, {"startnote"})

		vim.api.nvim_win_set_cursor(0, {1, 10})
		vim.cmd("startinsert!") end ) end'';
		
		type = "button";
		val = " •  | New TeX Note";
		opts = {
		  hl = "Functon";
		  position = "center";
		  shortcut = "1";
		};
	}
]
